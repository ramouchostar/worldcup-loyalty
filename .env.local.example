# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Restaurant — identifiant de cet établissement (molenbeek | anderlecht | schaerbeek)
NEXT_PUBLIC_RESTAURANT_ID=molenbeek
NEXT_PUBLIC_RESTAURANT_NAME=Belchicken

# Liens sociaux (par établissement)
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.google.com/?cid=XXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/belchicken
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@belchicken
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/belchicken

# Programme — pas de commandes avant cette date
NEXT_PUBLIC_PROGRAM_START_DATE=2026-06-01

# Mode auto-validation (true en dev uniquement, jamais en production)
NEXT_PUBLIC_AUTO_VALIDATE=false

# Web Push VAPID (générer avec: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@belchicken.be

# Cron secret (chaîne aléatoire forte, doit correspondre à Vercel → Settings → Cron)
CRON_SECRET=

# Emailing (Resend) — non configuré = envoi désactivé silencieusement (lib/email.ts)
RESEND_API_KEY=
EMAIL_FROM=Boosteats <onboarding@resend.dev>

# URL publique de l'app (liens absolus dans les emails, QR codes)
NEXT_PUBLIC_APP_URL=https://worldcup-loyalty.vercel.app

# Admin établissement bootstrappé (is_admin, à la première connexion)
ADMIN_EMAILS=

# Super-admin plateforme bootstrappé (is_super_admin, ADR 0015 §7, à la première connexion)
SUPER_ADMIN_EMAILS=

# Google Analytics 4 — ID de mesure du flux de données web (format G-XXXXXXXXXX).
# Non renseigné = aucun script Google n'est injecté, aucune bannière cookies,
# et la CSP reste fermée à Google (comportement voulu en dev et en preview).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Anthropic (vision : OCR ticket, découverte clé ticket, suggestions menu,
# détection de design m48) — requis en production, sinon ces fonctionnalités échouent
ANTHROPIC_API_KEY=

# Récap fondateurs (app/api/cron/founder-digest-daily + -weekly) — non
# configuré = digest désactivé silencieusement, même philosophie que
# RESEND_API_KEY plus haut.
# GITHUB_TOKEN : PAT lecture seule (scope "Contents" en lecture suffit,
# fine-grained scopé à ce repo) — lit les commits de master pour la section
# activité. Sans lui, le digest part quand même, juste sans les commits.
GITHUB_TOKEN=
# FOUNDER_DIGEST_EMAILS : liste séparée par des virgules, même motif que
# ADMIN_EMAILS/SUPER_ADMIN_EMAILS ci-dessus.
FOUNDER_DIGEST_EMAILS=
